# Local runtime overrides for docker-compose.yml. Copy to .env and edit.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aigora-local-password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Host port of the gRPC API (the container always listens on 50051).
GRPC_PORT=50051

# Optional: refuse to serve unless the published graph has this version.
GRAPH_VERSION_DEFAULT=

# Canonical graph file published on startup (path inside the image).
GRAPH_PUBLISH_INPUT=data/graph/canonical/graph.json

LOG_LEVEL=INFO
